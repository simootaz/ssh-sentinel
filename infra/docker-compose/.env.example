# ssh-sentinel, docker-compose settings. Copy to .env (gitignored) and fill in.
# Comments start with #. Values with spaces, quotes or # go between single quotes.

# ---------- Backend image ----------
# Leave as is to build from ../../backend/Dockerfile (docker compose build).
# Point it at a registry image to skip the local build (docker compose pull).
BACKEND_IMAGE=ssh-sentinel-backend:local

# Where the plain-HTTP port of the backend is published on the host. Keep it on
# 127.0.0.1: only Caddy or your own reverse proxy should reach it. Agents and
# phones talk HTTPS to the proxy.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080

# ---------- PostgreSQL, bundled db service ----------
POSTGRES_USER=sentinel
# Required. Long and random, it never leaves the compose network.
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel
# Host port for psql and backups, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# External PostgreSQL 14+ instead of the bundled one: set DATABASE_URL, then
# remove the db service and the depends_on block from docker-compose.yml.
#DATABASE_URL=postgres://user:password@db.example.com:5432/sentinel?sslmode=require

# ---------- Backend secrets ----------
# Bearer token shared by the phones: 32 random bytes, base64url. See infra/README.md
# for a generator. Required.
ADMIN_TOKEN=

# Firebase console > Project settings > General > Project ID. Required.
FCM_PROJECT_ID=

# Firebase service account key: the JSON file from Firebase console > Project
# settings > Service accounts > Generate new private key, on ONE line, between
# single quotes. Single quotes keep the \n sequences inside private_key literal,
# which the JSON needs. To produce the line from the downloaded file:
#   PowerShell: "FCM_SERVICE_ACCOUNT_JSON='" + ((Get-Content .\firebase-adminsdk.json -Raw) -replace "`r?`n", "") + "'"
#   Linux:      printf "FCM_SERVICE_ACCOUNT_JSON='%s'\n" "$(tr -d '\n' < firebase-adminsdk.json)"
# Required.
FCM_SERVICE_ACCOUNT_JSON=''

# ---------- Backend rules, defaults from backend/README.md ----------
# Seconds access-request waits for a verdict. Keep below the agent's 30 s budget.
VERDICT_WAIT_SECONDS=25
# Admin denials from one IP that trigger a block, inside the window.
AUTOBLOCK_THRESHOLD=3
AUTOBLOCK_WINDOW_SECONDS=3600
# How long a block lasts. 0 means until unblocked from the app.
AUTOBLOCK_DURATION_SECONDS=0
# Geolocation lookup endpoint. Empty disables geo, and geo rules then never match.
GEO_LOOKUP_URL=

# ---------- TLS, only with: docker compose --profile tls up -d ----------
# Public DNS name of this machine. Caddy obtains and renews the certificate;
# ports 80 and 443 must be open. localhost gives a self-signed certificate for local tests.
DOMAIN=localhost
